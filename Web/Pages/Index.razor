@page "/kappa"
@layout BaseMudBlazorLayout
@implements IDisposable
@inject KappaService KappaService
@inject TraderService TraderService
@inject QuestService QuestService

<PageTitle>Kappa Tracker</PageTitle>

<KappaLayout>
    <div class="kappa-grid">

        <!-- ===== Sidebar ===== -->
        <MudPaper Elevation="0" Class="spt-panel kappa-sidebar pa-3">
            <MudText Typo="Typo.overline" Class="spt-muted">Overall progress</MudText>

            @if (progress is null)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mt-2" />
            }
            else
            {
                <div class="d-flex align-baseline justify-space-between mt-1">
                    <MudText Typo="Typo.h4" Class="kappa-pct">@progress.OverallPercentage.ToString("0.0")%</MudText>
                    <MudText Typo="Typo.body2" Class="spt-muted">@progress.TotalMissionsCompleted / @progress.TotalMissionsRequired</MudText>
                </div>
                <MudProgressLinear Color="Color.Warning" Rounded="true" Size="Size.Large"
                                   Value="@progress.OverallPercentage" Class="my-2" />
                <MudText Typo="Typo.caption" Class="spt-muted">
                    Profile: <strong>@(string.IsNullOrWhiteSpace(progress.ProfileName) ? "—" : progress.ProfileName)</strong>@(progress.ProfileLevel > 0 ? $" · Lv {progress.ProfileLevel}" : "")
                </MudText>
            }

            <MudDivider Class="my-3" />
            <MudText Typo="Typo.overline" Class="spt-muted">Traders</MudText>

            @if (traders is null)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mt-2" />
            }
            else
            {
                <div class="kappa-traders mt-2">
                    @foreach (var t in traders)
                    {
                        <div class="kappa-trader @(selectedTraderId == t.TraderId ? "is-active" : "")"
                             @onclick="() => SelectTrader(t.TraderId)"
                             tabindex="0"
                             @onkeydown="@(e => OnTraderKey(e, t.TraderId))">
                            <div class="d-flex align-center justify-space-between">
                                <span class="kappa-trader-name">@t.Name</span>
                                <span class="kappa-ll @(t.CurrentLevel >= t.RequiredLevel ? "is-max" : "")">
                                    LL @t.CurrentLevel/@t.RequiredLevel
                                </span>
                            </div>
                            <MudProgressLinear Color="@TraderBarColor(t)" Rounded="true"
                                               Value="@t.ProgressPercentage" Class="my-1" />
                            <span class="kappa-trader-sub">@t.QuestCompleted / @t.QuestTotal quests</span>
                        </div>
                    }
                </div>
            }
        </MudPaper>

        <!-- ===== Main ===== -->
        <MudPaper Elevation="0" Class="spt-panel kappa-main pa-4">
            @if (currentTrader is null)
            {
                <div class="kappa-empty">
                    <MudIcon Icon="@Icons.Material.Outlined.TouchApp" Size="Size.Large" Class="spt-muted" />
                    <MudText Class="spt-muted">Select a trader to view its Kappa quests</MudText>
                </div>
            }
            else
            {
                <div class="d-flex align-baseline justify-space-between">
                    <MudText Typo="Typo.h5">@currentTrader.Name</MudText>
                    <MudText Typo="Typo.body2" Class="spt-muted">
                        @currentTrader.QuestCompleted / @currentTrader.QuestTotal completed &middot;
                        LL @currentTrader.CurrentLevel/@currentTrader.RequiredLevel
                    </MudText>
                </div>
                <MudProgressLinear Color="Color.Warning" Rounded="true" Size="Size.Large"
                                   Value="@currentTrader.ProgressPercentage" Class="mt-2 mb-4" />

                @if (quests is null)
                {
                    <MudProgressCircular Indeterminate="true" />
                }
                else if (quests.Count == 0)
                {
                    <MudText Class="spt-muted">No Kappa quests for this trader.</MudText>
                }
                else
                {
                    <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="kappa-quests" @key="selectedTraderId">
                        @foreach (var q in quests)
                        {
                            var readyCount = q.ReadyRequirementCount;
                            <MudExpansionPanel @key="q.QuestId" Class="@($"kappa-quest kappa-quest--{q.Status.ToString().ToLowerInvariant()}")">
                                <TitleContent>
                                    <div class="d-flex align-center gap-2 kappa-quest-title">
                                        <MudIcon Size="Size.Small" Icon="@StatusIcon(q.Status)" Color="@StatusColor(q.Status)" />
                                        <span class="kappa-quest-name">@q.Title</span>
                                        <span class="@($"kappa-status kappa-status--{q.Status.ToString().ToLowerInvariant()}")">@StatusLabel(q.Status)</span>
                                        @if (q.Requirements.Count > 0)
                                        {
                                            <span class="kappa-quest-count @(readyCount == q.Requirements.Count ? "is-full" : "")">
                                                @readyCount/@q.Requirements.Count
                                            </span>
                                        }
                                    </div>
                                </TitleContent>
                                <ChildContent>
                                    @if (!string.IsNullOrWhiteSpace(q.Description))
                                    {
                                        <MudText Typo="Typo.body2" Class="spt-muted kappa-quest-desc">@q.Description</MudText>
                                    }

                                    <QuestRequirements Requirements="q.Requirements" />

                                    @if (q.PrerequisiteChain.Count > 0)
                                    {
                                        <div class="kappa-chain">
                                            <button type="button" class="kappa-chain-toggle"
                                                    aria-expanded="@(chainOpen.Contains(q.QuestId))"
                                                    @onclick="() => ToggleChain(q.QuestId)">
                                                <MudIcon Size="Size.Small"
                                                         Icon="@(chainOpen.Contains(q.QuestId) ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)" />
                                                <span>Path to unlock</span>
                                                <span class="kappa-chain-count @(q.PrereqCompletedCount == q.PrereqTotal ? "is-full" : "")">
                                                    @q.PrereqCompletedCount / @q.PrereqTotal
                                                </span>
                                            </button>
                                            <MudCollapse Expanded="chainOpen.Contains(q.QuestId)">
                                                @if (chainOpen.Contains(q.QuestId))
                                                {
                                                    <ol class="kappa-chain-list">
                                                        @foreach (var n in q.PrerequisiteChain)
                                                        {
                                                            <li class="@($"kappa-chain-row kappa-chain-row--clickable {(n.IsDone ? "is-done" : n.GateSatisfied ? "is-satisfied" : "")}")"
                                                                role="button" tabindex="0"
                                                                @onclick="() => OpenQuestModal(n.QuestId)"
                                                                @onkeydown="@(e => OnChainRowKey(e, n.QuestId))">
                                                                <MudIcon Size="Size.Small" Icon="@StatusIcon(n.Status)" Color="@StatusColor(n.Status)" />
                                                                <span class="kappa-chain-name">
                                                                    @(string.IsNullOrWhiteSpace(n.Title) ? n.QuestId : n.Title)
                                                                </span>
                                                                @if (n.IsKappaMilestone)
                                                                {
                                                                    <span class="kappa-chain-tag">Kappa</span>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(n.GateNote))
                                                                {
                                                                    <span class="kappa-chain-gate">@n.GateNote</span>
                                                                }
                                                                <span class="kappa-chain-status">@StatusLabel(n.Status)</span>
                                                            </li>
                                                        }
                                                    </ol>
                                                }
                                            </MudCollapse>
                                        </div>
                                    }
                                </ChildContent>
                            </MudExpansionPanel>
                        }
                    </MudExpansionPanels>
                }
            }
        </MudPaper>
    </div>

    <QuestDetailModal Quest="modalQuest" OnClose="CloseQuestModal" />
</KappaLayout>

@code {
    private KappaProgressViewModel? progress;
    private List<TraderViewModel>? traders;
    private List<QuestViewModel>? quests;
    private TraderViewModel? currentTrader;
    private string? selectedTraderId;
    private System.Threading.Timer? refreshTimer;

    private readonly HashSet<string> chainOpen = new();

    private QuestViewModel? modalQuest;

    private void OpenQuestModal(string questId)
    {
        try
        {
            modalQuest = QuestService.GetQuestDetail(questId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[KappaTracker] Failed to load quest detail {questId}: {ex.Message}");
        }
    }

    private void CloseQuestModal() => modalQuest = null;

    private void OnChainRowKey(KeyboardEventArgs e, string questId)
    {
        if (e.Key is "Enter" or " ")
            OpenQuestModal(questId);
    }

    private void ToggleChain(string questId)
    {
        if (!chainOpen.Remove(questId))
            chainOpen.Add(questId);
    }

    protected override void OnInitialized()
    {
        Reload();

        // Auto-sync every 5 seconds; disposed with the component.
        refreshTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                Reload();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private void Reload()
    {
        try
        {
            progress = KappaService.GetKappaProgress();
            traders = TraderService.GetAllTraders();

            if (selectedTraderId is not null)
            {
                currentTrader = traders.FirstOrDefault(t => t.TraderId == selectedTraderId);
                quests = currentTrader is null ? null : QuestService.GetQuestsByTrader(selectedTraderId);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[KappaTracker] UI reload failed: {ex.Message}");
        }
    }

    private void SelectTrader(string traderId)
    {
        selectedTraderId = traderId;
        chainOpen.Clear();
        modalQuest = null;
        currentTrader = traders?.FirstOrDefault(t => t.TraderId == traderId);
        try
        {
            quests = QuestService.GetQuestsByTrader(traderId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[KappaTracker] Failed to load quests: {ex.Message}");
        }
    }

    private void OnTraderKey(KeyboardEventArgs e, string traderId)
    {
        if (e.Key is "Enter" or " ")
            SelectTrader(traderId);
    }

    private static Color TraderBarColor(TraderViewModel t) =>
        t.QuestTotal > 0 && t.QuestCompleted == t.QuestTotal ? Color.Success : Color.Warning;

    private static string StatusIcon(KappaQuestStatus s) => s switch
    {
        KappaQuestStatus.Completed => Icons.Material.Filled.CheckCircle,
        KappaQuestStatus.ReadyToHandIn => Icons.Material.Filled.AssignmentTurnedIn,
        KappaQuestStatus.InProgress => Icons.Material.Filled.Autorenew,
        KappaQuestStatus.Available => Icons.Material.Outlined.RadioButtonUnchecked,
        KappaQuestStatus.Failed => Icons.Material.Filled.Cancel,
        _ => Icons.Material.Filled.Lock
    };

    private static Color StatusColor(KappaQuestStatus s) => s switch
    {
        KappaQuestStatus.Completed => Color.Success,
        KappaQuestStatus.ReadyToHandIn => Color.Warning,
        KappaQuestStatus.InProgress => Color.Info,
        KappaQuestStatus.Failed => Color.Error,
        _ => Color.Default
    };

    private static string StatusLabel(KappaQuestStatus s) => s switch
    {
        KappaQuestStatus.Completed => "Completed",
        KappaQuestStatus.ReadyToHandIn => "Turn in",
        KappaQuestStatus.InProgress => "In progress",
        KappaQuestStatus.Available => "Available",
        KappaQuestStatus.Failed => "Failed",
        _ => "Locked"
    };

    public void Dispose() => refreshTimer?.Dispose();
}
