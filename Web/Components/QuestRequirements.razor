@if (Requirements.Count == 0)
{
    <MudText Typo="Typo.caption" Class="spt-muted">No tracked requirements.</MudText>
}
else
{
    <div class="kappa-reqs">
        @foreach (var r in Requirements)
        {
            <div class="kappa-req @(r.IsMet ? "is-met" : "")">
                <MudIcon Size="Size.Small"
                         Icon="@(r.IsMet ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.Circle)"
                         Color="@(r.IsMet ? Color.Success : Color.Default)" />
                @if (r.IsItem)
                {
                    @foreach (var tpl in r.ItemIds)
                    {
                        <MudTooltip Placement="Placement.Top" Arrow="true" Delay="120">
                            <ChildContent>
                                <img class="kappa-req-icon" src="@($"kappa/api/icon/{tpl}")"
                                     alt="" loading="lazy" />
                            </ChildContent>
                            <TooltipContent>
                                <div class="kappa-icon-pop">
                                    <img src="@($"kappa/api/icon/{tpl}")" alt="" loading="lazy" />
                                    @if (!string.IsNullOrWhiteSpace(r.ItemName))
                                    {
                                        <span class="kappa-icon-pop-name">@r.ItemName</span>
                                    }
                                </div>
                            </TooltipContent>
                        </MudTooltip>
                    }
                }
                <span class="kappa-req-text">
                    @(string.IsNullOrWhiteSpace(r.Description) ? r.Type : r.Description)
                </span>
                @if (r.ShowCounter)
                {
                    <span class="kappa-req-count @(r.IsEnough ? "is-enough" : "")">
                        @r.DisplayCurrent / @r.DisplayTarget@(r.FoundInRaidRequired ? " FiR" : "")
                    </span>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public List<QuestRequirementViewModel> Requirements { get; set; } = new();
}
