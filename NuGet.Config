<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Adds the BepInEx feed alongside the inherited nuget.org source (used for the
       SPTushonka.* server packages and Microsoft.NETFramework.ReferenceAssemblies). -->
  <packageSources>
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
</configuration>
