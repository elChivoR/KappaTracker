<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>1.3.0</Version>
    <OutputPath>bin\$(Configuration)\SPT_Runtime\user\mods\KappaTracker\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="client\**\*.cs" />
    <Content Remove="client\**\*" />
    <None Remove="client\**\*" />
    <!-- Repo-root NuGet.Config is for restore only; keep it out of the mod output. -->
    <Content Remove="NuGet.Config" />
    <None Remove="NuGet.Config" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SPTushonka.Common" Version="4.1.3" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.3" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.3" />
    <PackageReference Include="SPTushonka.Server.Web" Version="4.1.3" />
  </ItemGroup>
  <Target Name="CopyWwwroot" AfterTargets="Build">
    <ItemGroup>
      <WwwrootFiles Include="wwwroot\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WwwrootFiles)" DestinationFiles="@(WwwrootFiles->'$(OutputPath)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
