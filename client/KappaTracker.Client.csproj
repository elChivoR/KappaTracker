<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>KappaTracker.Client</AssemblyName>
    <RootNamespace>KappaTracker.Client</RootNamespace>
    <Version>1.1.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- BepInEx\ sits at the SPT root as a sibling of SPT_Runtime\ (not inside it), so this
         plugin is emitted into a top-level BepInEx\ tree; Directory.Build.targets packages
         both trees at the archive root (see its PackageSptRuntime target). -->
    <OutputPath>$(MSBuildThisFileDirectory)..\bin\$(Configuration)\BepInEx\plugins\KappaTracker\</OutputPath>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <EftManaged Condition="'$(EFT_MANAGED)' != ''">$(EFT_MANAGED)</EftManaged>
    <EftManaged Condition="'$(EftManaged)' == ''">$(MSBuildThisFileDirectory)refs</EftManaged>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\ModInfo.cs" Link="ModInfo.cs" />
    <!-- The test project lives in a subfolder; keep its sources and the non-redistributable
         reference DLLs out of every default glob so $(EftManaged) is the only resolution path. -->
    <Compile Remove="KappaTracker.Client.Tests\**\*.cs" />
    <Compile Remove="refs\**\*.cs" />
    <None Remove="refs\**" />
    <Content Remove="refs\**" />
    <None Remove="KappaTracker.Client.Tests\**" />
    <Content Remove="KappaTracker.Client.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(EftManaged)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(EftManaged)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(EftManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(EftManaged)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="spt-common">
      <HintPath>$(EftManaged)\spt-common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(EftManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(EftManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(EftManaged)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
